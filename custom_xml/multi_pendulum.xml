<mujoco model="multi inverted pendulum">
	<compiler inertiafromgeom="true"/>
	<default>
		<joint armature="0" damping="1" limited="true"/>
		<geom contype="0" friction="1 0.1 0.1" rgba="0.7 0.7 0 1"/>
		<tendon/>
		<motor ctrlrange="-3 3"/>
	</default>
	<option gravity="0 0 -9.81" integrator="RK4" timestep="0.02"/>
	<size nstack="3000"/>
	<worldbody>
		<!--geom name="ground" type="plane" pos="0 0 0" /-->
		<!-- 1st body -->
		<geom name="rail_1" pos="1 0 0" quat="0.707 0 0.707 0" rgba="0.3 0.3 0.7 1" size="0.02 1" type="capsule"/>
		<body name="cart_1" pos="1 0 0">
			<joint axis="1 0 0" limited="true" name="slider_1" pos="0 0 0" range="-1 1" type="slide"/>
			<geom name="cart_geom_1" pos="0 0 0" quat="0.707 0 0.707 0" size="0.1 0.1" type="capsule"/>
			<body name="pole_1" pos="0 0 0">
				<joint axis="0 1 0" name="hinge_1" pos="0 0 0" range="-90 90" type="hinge"/>
				<geom fromto="0 0 0 0.001 0 0.6" name="cpole_1" rgba="0 0.7 0.7 1" size="0.049 0.3" type="capsule"/>
				<!--                 <body name="pole2" pos="0.001 0 0.6"><joint name="hinge2" type="hinge" pos="0 0 0" axis="0 1 0"/><geom name="cpole2" type="capsule" fromto="0 0 0 0 0 0.6" size="0.05 0.3" rgba="0.7 0 0.7 1"/><site name="tip2" pos="0 0 .6"/></body>-->
			</body>
		</body>
		
		<!-- 2nd body -->
		<geom name="rail_2" pos="-0.5 2 0" quat="0.707 0 0.707 0" rgba="0.3 0.3 0.7 1" size="0.02 1" type="capsule"/>
		<body name="cart_2" pos="0 2 0">
			<joint axis="1 0 0" limited="true" name="slider_2" pos="0 0 0" range="-1 1" type="slide"/>
			<geom name="cart_geom_2" pos="0 0 0" quat="0.707 0 0.707 0" size="0.1 0.1" type="capsule"/>
			<body name="pole_2" pos="0 0 0">
				<joint axis="0 1 0" name="hinge_2" pos="0 0 0" range="-90 90" type="hinge"/>
				<geom fromto="0 0 0 0.001 0 0.6" name="cpole_2" rgba="0 0.7 0.7 1" size="0.049 0.3" type="capsule"/>
				<!--                 <body name="pole2" pos="0.001 0 0.6"><joint name="hinge2" type="hinge" pos="0 0 0" axis="0 1 0"/><geom name="cpole2" type="capsule" fromto="0 0 0 0 0 0.6" size="0.05 0.3" rgba="0.7 0 0.7 1"/><site name="tip2" pos="0 0 .6"/></body>-->
			</body>
		</body>
		
		<!-- 3rd body -->
		<geom name="rail_3" pos="0.5 0 1" quat="0.707 0 0.707 0" rgba="0.3 0.3 0.7 1" size="0.02 1" type="capsule"/>
		<body name="cart_3" pos="0.5 0 1">
			<joint axis="1 0 0" limited="true" name="slider_3" pos="0 0 0" range="-1 1" type="slide"/>
			<geom name="cart_geom_3" pos="0 0 0" quat="0.707 0 0.707 0" size="0.1 0.1" type="capsule"/>
			<body name="pole_3" pos="0 0 0">
				<joint axis="0 1 0" name="hinge_3" pos="0 0 0" range="-90 90" type="hinge"/>
				<geom fromto="0 0 0 0.001 0 0.6" name="cpole_3" rgba="0 0.7 0.7 1" size="0.049 0.3" type="capsule"/>
				<!--                 <body name="pole2" pos="0.001 0 0.6"><joint name="hinge2" type="hinge" pos="0 0 0" axis="0 1 0"/><geom name="cpole2" type="capsule" fromto="0 0 0 0 0 0.6" size="0.05 0.3" rgba="0.7 0 0.7 1"/><site name="tip2" pos="0 0 .6"/></body>-->
			</body>
		</body>
		
		<!-- 4th body -->
		<geom name="rail_4" pos="-1 0 0" quat="0.707 0 0.707 0" rgba="0.3 0.3 0.7 1" size="0.02 1" type="capsule"/>
		<body name="cart_4" pos="-1 0 0">
			<joint axis="1 0 0" limited="true" name="slider_4" pos="0 0 0" range="-1 1" type="slide"/>
			<geom name="cart_geom_4" pos="0 0 0" quat="0.707 0 0.707 0" size="0.1 0.1" type="capsule"/>
			<body name="pole_4" pos="0 0 0">
				<joint axis="0 1 0" name="hinge_4" pos="0 0 0" range="-90 90" type="hinge"/>
				<geom fromto="0 0 0 0.001 0 0.6" name="cpole_4" rgba="0 0.7 0.7 1" size="0.049 0.3" type="capsule"/>
				<!--                 <body name="pole2" pos="0.001 0 0.6"><joint name="hinge2" type="hinge" pos="0 0 0" axis="0 1 0"/><geom name="cpole2" type="capsule" fromto="0 0 0 0 0 0.6" size="0.05 0.3" rgba="0.7 0 0.7 1"/><site name="tip2" pos="0 0 .6"/></body>-->
			</body>
		</body>
	</worldbody>
	<actuator>
		<motor ctrllimited="true" ctrlrange="-3 3" gear="100" joint="slider_1" name="slide_1"/>
		<motor ctrllimited="true" ctrlrange="-3 3" gear="100" joint="slider_2" name="slide_2"/>
		<motor ctrllimited="true" ctrlrange="-3 3" gear="100" joint="slider_3" name="slide_3"/>
		<motor ctrllimited="true" ctrlrange="-3 3" gear="100" joint="slider_4" name="slide_4"/>
	</actuator>
</mujoco>